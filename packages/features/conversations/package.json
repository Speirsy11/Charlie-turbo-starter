{
  "name": "@charlie/conversations",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/index-server.d.ts",
      "default": "./src/index-server.ts"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./src/env.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "push": "pnpm with-env drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "vitest run --config vitest.config.backend.ts",
    "test:frontend": "vitest run --config vitest.config.frontend.ts",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../../.env --"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@charlie/auth": "workspace:*",
    "@charlie/chat": "workspace:*",
    "@charlie/db": "workspace:*",
    "@charlie/env-schema": "workspace:*",
    "@charlie/query-client": "workspace:*",
    "@charlie/trpc": "workspace:*",
    "@charlie/ui": "workspace:*",
    "@charlie/validators": "workspace:*",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:react19",
    "server-only": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@charlie/eslint-config": "workspace:*",
    "@charlie/prettier-config": "workspace:*",
    "@charlie/tsconfig": "workspace:*",
    "@charlie/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@charlie/prettier-config"
}
