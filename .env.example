# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# Database (plain Postgres via postgres.js — point these at any Postgres instance,
# e.g. a local Docker container, Neon, RDS, etc.)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="charlie"

# Clerk
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Local development only: use a stable local user ID instead of signing in.
# Never set this in a deployed environment; production startup will refuse it.
DEV_AUTH_USER_ID=

# Anthropic (Vercel AI SDK)
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=""
