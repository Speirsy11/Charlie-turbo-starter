{
  "name": "@charlie/nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@charlie/admin": "workspace:*",
    "@charlie/auth": "workspace:*",
    "@charlie/conversations": "workspace:*",
    "@charlie/env-schema": "workspace:*",
    "@charlie/trpc": "workspace:*",
    "@charlie/ui": "workspace:*",
    "@clerk/nextjs": "^7.3.5",
    "@t3-oss/env-nextjs": "^0.13.8",
    "next": "^16.0.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "devDependencies": {
    "@charlie/eslint-config": "workspace:*",
    "@charlie/prettier-config": "workspace:*",
    "@charlie/tailwind-config": "workspace:*",
    "@charlie/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "jiti": "^2.5.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  },
  "prettier": "@charlie/prettier-config"
}
